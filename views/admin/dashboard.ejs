<%- include('../partials/admin-header') %>
<div class="admin-heading"><div><p class="eyebrow">OVERVIEW</p><h1>Dashboard</h1></div><a class="button" href="/admin/products/new">Add product</a></div>
<div class="stat-grid"><div class="stat-card"><span>Products</span><strong><%= stats.products %></strong></div><div class="stat-card"><span>Categories</span><strong><%= stats.categories %></strong></div><div class="stat-card"><span>Orders</span><strong><%= stats.orders %></strong></div><div class="stat-card"><span>Pending</span><strong><%= stats.pending %></strong></div><div class="stat-card"><span>Low stock</span><strong><%= stats.lowStock %></strong></div></div>
<section class="panel"><div class="section-heading"><h2>Recent orders</h2><a href="/admin/orders">View all</a></div><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Total</th><th>Status</th><th>Date</th></tr></thead><tbody><% recentOrders.forEach(order => { %><tr><td><a href="/admin/orders/<%= order._id %>"><%= order.orderNumber %></a></td><td><%= order.customerName %></td><td><%= money(order.total) %></td><td><span class="status status-<%= order.status %>"><%= order.status %></span></td><td><%= new Date(order.createdAt).toLocaleDateString('en-GB') %></td></tr><% }) %><% if (!recentOrders.length) { %><tr><td colspan="5">No orders yet.</td></tr><% } %></tbody></table></div></section>
<%- include('../partials/admin-footer') %>
