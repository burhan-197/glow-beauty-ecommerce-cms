<%- include('../partials/admin-header') %>
<div class="admin-heading"><div><p class="eyebrow">SALES</p><h1>Orders</h1></div><form method="get"><select name="status" onchange="this.form.submit()"><option value="all">All statuses</option><% ['pending','processing','shipped','delivered','cancelled'].forEach(s => { %><option value="<%= s %>" <%= selectedStatus === s ? 'selected' : '' %>><%= s[0].toUpperCase()+s.slice(1) %></option><% }) %></select></form></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Payment</th><th>Status</th><th>Date</th></tr></thead><tbody><% orders.forEach(order => { %><tr><td><a href="/admin/orders/<%= order._id %>"><%= order.orderNumber %></a></td><td><%= order.customerName %><br><span class="muted"><%= order.phone %></span></td><td><%= order.items.reduce((n,item)=>n+item.qty,0) %></td><td><%= money(order.total) %></td><td><%= order.paymentMethod === 'cod' ? 'COD' : 'Manual' %></td><td><span class="status status-<%= order.status %>"><%= order.status %></span></td><td><%= new Date(order.createdAt).toLocaleDateString('en-GB') %></td></tr><% }) %><% if (!orders.length) { %><tr><td colspan="7">No orders found.</td></tr><% } %></tbody></table></div></section>
<%- include('../partials/admin-footer') %>
