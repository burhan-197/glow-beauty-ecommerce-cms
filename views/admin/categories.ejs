<%- include('../partials/admin-header') %>
<div class="admin-heading"><div><p class="eyebrow">CATALOG</p><h1>Categories</h1></div></div>
<% if (error) { %><div class="alert"><%= error %></div><% } %>
<div class="admin-two-col"><form class="panel admin-form" method="post" action="/admin/categories"><h2>Add category</h2><label>Name<input name="name" required maxlength="80"></label><label>Slug <span class="muted">(optional)</span><input name="slug" maxlength="100" placeholder="auto-generated"></label><button class="button" type="submit">Add category</button></form><section class="panel"><h2>Existing categories</h2><div class="category-list"><% categories.forEach(category => { %><div class="category-row"><form method="post" action="/admin/categories/<%= category._id %>" class="category-edit"><input name="name" value="<%= category.name %>" required><input name="slug" value="<%= category.slug %>" required><span class="muted"><%= countMap[String(category._id)] || 0 %> products</span><button class="small-button" type="submit">Save</button></form><form method="post" action="/admin/categories/<%= category._id %>/delete" onsubmit="return confirm('Delete this category?')"><button class="link-button danger" type="submit">Delete</button></form></div><% }) %><% if (!categories.length) { %><p>No categories yet.</p><% } %></div></section></div>
<%- include('../partials/admin-footer') %>
