<%- include('../partials/admin-header') %>
<div class="admin-heading"><div><p class="eyebrow">ORDER</p><h1><%= order.orderNumber %></h1></div><a href="/admin/orders">Back to orders</a></div>
<div class="admin-two-col"><section class="panel"><h2>Items</h2><% order.items.forEach(item => { %><div class="order-item"><img src="<%= item.image || '/images/placeholder.svg' %>" alt=""><div><strong><%= item.name %></strong><p><%= money(item.price) %> × <%= item.qty %></p></div><strong><%= money(item.price * item.qty) %></strong></div><% }) %><div class="summary-row"><span>Total</span><strong><%= money(order.total) %></strong></div></section><aside class="panel"><h2>Customer</h2><p><strong><%= order.customerName %></strong><br><%= order.phone %><% if (order.email) { %><br><%= order.email %><% } %></p><p><%= order.address %><br><%= order.city %></p><% if (order.notes) { %><p><strong>Notes</strong><br><%= order.notes %></p><% } %><p><strong>Payment:</strong> <%= order.paymentMethod === 'cod' ? 'Cash on delivery' : 'Manual payment' %></p><form class="admin-form" method="post" action="/admin/orders/<%= order._id %>/status"><label>Status<select name="status"><% ['pending','processing','shipped','delivered','cancelled'].forEach(s => { %><option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s[0].toUpperCase()+s.slice(1) %></option><% }) %></select></label><button class="button" type="submit">Update status</button></form></aside></div>
<%- include('../partials/admin-footer') %>
