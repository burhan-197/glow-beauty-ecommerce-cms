<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <% if (metaDescription) { %><meta name="description" content="<%= metaDescription %>"><% } %>
  <link rel="stylesheet" href="/css/lite.css">
</head>
<body>
<header class="site-header">
  <a class="brand" href="/">GLOW BEAUTY</a>
  <button class="nav-toggle" type="button" aria-label="Toggle navigation" data-nav-toggle>☰</button>
  <nav class="main-nav" data-nav>
    <a href="/">Home</a>
    <a href="/products">Shop</a>
    <% navCategories.slice(0, 5).forEach(category => { %>
      <a href="/products?category=<%= encodeURIComponent(category.slug) %>"><%= category.name %></a>
    <% }) %>
    <a class="cart-link" href="/cart">Cart <span class="cart-badge" data-cart-count>0</span></a>
  </nav>
</header>
<main>
